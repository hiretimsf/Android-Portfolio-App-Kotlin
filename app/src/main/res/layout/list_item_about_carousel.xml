<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/about_carousel_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_300sdp"
        android:paddingStart="@dimen/_10sdp"
        android:paddingTop="@dimen/_10sdp"
        android:paddingEnd="@dimen/_10sdp"
        android:paddingBottom="@dimen/_10sdp">

    <com.google.android.material.card.MaterialCardView
            android:id="@+id/about_carousel_card"
            android:layout_width="@dimen/dimen_0dp"
            android:layout_height="@dimen/dimen_0dp"
            app:cardCornerRadius="@dimen/_5sdp"
            app:cardElevation="@dimen/dimen_2dp"
            app:cardPreventCornerOverlap="false"
            app:cardUseCompatPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/about_carousel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"/>

    </com.google.android.material.card.MaterialCardView>

    <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/about_carousel_previous"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="@drawable/bg_carousel_control"
            android:contentDescription="@string/cd_previous_photo"
            android:padding="@dimen/_8sdp"
            android:elevation="@dimen/elevation_4dp"
            app:layout_constraintBottom_toBottomOf="@+id/about_carousel_card"
            app:layout_constraintStart_toStartOf="@+id/about_carousel_card"
            app:layout_constraintTop_toTopOf="@+id/about_carousel_card"
            app:srcCompat="@drawable/ic_chevron_left"
            app:tint="@color/colorOnPrimary"/>

    <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/about_carousel_next"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:background="@drawable/bg_carousel_control"
            android:contentDescription="@string/cd_next_photo"
            android:padding="@dimen/_8sdp"
            android:elevation="@dimen/elevation_4dp"
            app:layout_constraintBottom_toBottomOf="@+id/about_carousel_card"
            app:layout_constraintEnd_toEndOf="@+id/about_carousel_card"
            app:layout_constraintTop_toTopOf="@+id/about_carousel_card"
            app:srcCompat="@drawable/ic_chevron_right"
            app:tint="@color/colorOnPrimary"/>

    <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/about_carousel_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_8sdp"
            android:background="@drawable/bg_carousel_status"
            android:gravity="center"
            android:minWidth="@dimen/_44sdp"
            android:paddingStart="@dimen/_8sdp"
            android:paddingTop="@dimen/_4sdp"
            android:paddingEnd="@dimen/_8sdp"
            android:paddingBottom="@dimen/_4sdp"
            android:textAppearance="?attr/textAppearanceBody1"
            android:textColor="@color/colorOnPrimary"
            android:textSize="@dimen/dimen_14sp"
            android:elevation="@dimen/elevation_4dp"
            app:layout_constraintBottom_toBottomOf="@+id/about_carousel_card"
            app:layout_constraintEnd_toEndOf="@+id/about_carousel_card"
            app:layout_constraintStart_toStartOf="@+id/about_carousel_card"
            tools:text="1 / 3"/>

</androidx.constraintlayout.widget.ConstraintLayout>
