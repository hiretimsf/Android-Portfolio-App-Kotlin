<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:id="@+id/main_nav"
            app:startDestination="@id/profile_screen">

    <!-- Welcome screen -->
    <fragment android:id="@+id/welcome_screen"
              android:name="hiretimsf.com.app.screens.welcome.WelcomeFragment"
              tools:layout="@layout/fragment_welcome">

        <action android:id="@+id/action_to_profile_screen"
                app:destination="@id/profile_screen"
                app:enterAnim="@anim/fade_in"
                app:exitAnim="@anim/fade_out"
                app:popEnterAnim="@anim/fade_in"
                app:popExitAnim="@anim/fade_out"
                app:popUpTo="@+id/welcome_screen"
                app:popUpToInclusive="true"/>
    </fragment>

    <!-- Global action to welcome screen -->
    <action android:id="@+id/action_global_to_welcome_screen"
            app:destination="@id/welcome_screen"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out"
            app:popUpTo="@id/main_nav"/>

    <!-- Experience screen -->
    <fragment android:id="@+id/experience_screen"
              android:name="hiretimsf.com.app.screens.experience.ExperienceFragment"
              android:label="@string/menu_experience"
              tools:layout="@layout/fragment_experience">

        <!-- Action to experience detail screen -->
        <action android:id="@+id/action_to_experience_detail_screen"
                app:destination="@id/experience_detail_screen"
                app:enterAnim="@anim/fade_in"
                app:exitAnim="@anim/fade_out"
                app:popEnterAnim="@anim/fade_in"
                app:popExitAnim="@anim/fade_out">
            <argument
                    android:name="id"
                    android:defaultValue="@null"
                    app:argType="string"
                    app:nullable="true"/>
            <argument
                    android:name="company"
                    android:defaultValue="@null"
                    app:argType="string"
                    app:nullable="true"/>
        </action>
    </fragment>

    <!-- Experience detail screen -->
    <fragment android:id="@+id/experience_detail_screen"
              android:name="hiretimsf.com.app.screens.experience.detail.ExperienceDetailFragment"
              android:label="{company}"
              tools:layout="@layout/fragment_experience_detail">

        <argument
                android:name="id"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true"/>
        <argument
                android:name="company"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true"/>
    </fragment>

    <!-- Settings screen -->
    <fragment android:id="@+id/settings_screen"
              android:name="hiretimsf.com.app.screens.settings.SettingsFragment"
              android:label="@string/menu_settings">
    </fragment>

    <!-- App info dialog -->
    <dialog android:id="@+id/app_info_dialog"
            android:name="hiretimsf.com.app.screens.settings.dialog.AppDialogFragment"
            android:label="@string/dialog_app_info"/>

    <!-- Global action to app info dialog -->
    <action android:id="@+id/action_global_to_app_info_dialog"
            app:destination="@id/app_info_dialog"
            app:popUpTo="@id/app_info_dialog"
            app:popUpToInclusive="true"/>

    <!-- Profile screen -->
    <navigation
            android:id="@+id/profile_screen"
            app:startDestination="@id/profile">

        <!-- Profile -->
        <fragment
                android:id="@+id/profile"
                android:name="hiretimsf.com.app.screens.profile.ProfileFragment"
                android:label="@string/menu_profile"
                tools:layout="@layout/fragment_profile">

            <deepLink app:uri="https://www.tumur.me/profile"/>

            <action
                    android:id="@+id/action_to_social"
                    app:destination="@id/social"
                    app:enterAnim="@anim/slide_up"
                    app:exitAnim="@anim/slide_down"
                    app:popEnterAnim="@anim/slide_up"
                    app:popExitAnim="@anim/slide_down"/>

        </fragment>

        <!-- Social -->
        <dialog
                android:id="@+id/social"
                android:name="hiretimsf.com.app.screens.profile.bottomsheet.ProfileBottomSheetFragment">
        </dialog>
    </navigation>

    <!-- Portfolio screen -->
    <fragment android:id="@+id/portfolio_screen"
              android:name="hiretimsf.com.app.screens.portfolio.PortfolioFragment"
              android:label="@string/menu_portfolio"
              tools:layout="@layout/fragment_portfolio">

        <!-- Action to portfolio detail screen -->
        <action android:id="@+id/action_to_portfolio_detail_screen"
                app:destination="@id/portfolio_detail_screen"
                app:enterAnim="@anim/fade_in"
                app:exitAnim="@anim/fade_out"
                app:popEnterAnim="@anim/fade_in"
                app:popExitAnim="@anim/fade_out">
            <argument
                    android:name="id"
                    android:defaultValue="@null"
                    app:argType="string"
                    app:nullable="true"/>
            <argument
                    android:name="title"
                    android:defaultValue="@null"
                    app:argType="string"
                    app:nullable="true"/>
        </action>
    </fragment>

    <!-- Portfolio detail screen -->
    <fragment android:id="@+id/portfolio_detail_screen"
              android:name="hiretimsf.com.app.screens.portfolio.detail.PortfolioDetailFragment"
              android:label="{title}"
              tools:layout="@layout/fragment_portfolio_detail">

        <argument
                android:name="id"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true"/>
        <argument
                android:name="title"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true"/>

        <!-- Action to portfolio detail screen video -->
        <action android:id="@+id/action_to_portfolio_detail_screen_preview"
                app:destination="@id/portfolio_detail_screen_preview"
                app:enterAnim="@anim/fade_in"
                app:exitAnim="@anim/fade_out"
                app:popEnterAnim="@anim/fade_in"
                app:popExitAnim="@anim/fade_out">
            <argument
                    android:name="id"
                    android:defaultValue="@null"
                    app:argType="string"
                    app:nullable="true"/>
            <argument
                    android:name="order"
                    android:defaultValue="1"
                    app:argType="integer"/>
        </action>

    </fragment>

    <!-- Preview -->
    <fragment
            android:id="@+id/portfolio_detail_screen_preview"
            android:name="hiretimsf.com.app.screens.portfolio.detail.preview.PreviewFragment"
            android:label="@string/preview"
            tools:layout="@layout/fragment_preview">
        <argument
                android:name="id"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true"/>
        <argument
                android:name="order"
                android:defaultValue="1"
                app:argType="integer"/>
    </fragment>

    <!-- Favorite screen -->
    <fragment android:id="@+id/favorite_screen"
              android:name="hiretimsf.com.app.screens.favorite.FavoriteFragment"
              android:label="@string/menu_favorite"
              tools:layout="@layout/fragment_favorite">

        <!-- Action to portfolio detail screen -->
        <action android:id="@+id/action_to_portfolio_detail_screen"
                app:destination="@id/portfolio_detail_screen"
                app:enterAnim="@anim/fade_in"
                app:exitAnim="@anim/fade_out"
                app:popEnterAnim="@anim/fade_in"
                app:popExitAnim="@anim/fade_out">
            <argument
                    android:name="id"
                    android:defaultValue="@null"
                    app:argType="string"
                    app:nullable="true"/>
            <argument
                    android:name="title"
                    android:defaultValue="@null"
                    app:argType="string"
                    app:nullable="true"/>
        </action>
    </fragment>

</navigation>
